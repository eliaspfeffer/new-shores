{
  "name": "new-shores",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "A browser real-time strategy and settlement-building game inspired by Age of Empires and The Settlers IV. Build settlements, manage production chains, explore, and raise armies.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
